{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"defaultDuotone": false,
			"duotone": [],
			"gradients": [],
			"palette": [
				{ "slug": "cream", "name": "Soft Cream", "color": "#F6F4F0" },
				{ "slug": "white", "name": "Blanco", "color": "#FFFFFF" },
				{ "slug": "charcoal", "name": "Charcoal", "color": "#1E1E1E" },
				{ "slug": "sage", "name": "Sage Green", "color": "#A6B2A0" },
				{ "slug": "silver", "name": "Silver Gray", "color": "#D7D9D3" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1280px"
		},
		"spacing": {
			"units": [ "px", "rem", "%" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "8", "size": "8px" },
				{ "slug": "30", "name": "16", "size": "16px" },
				{ "slug": "40", "name": "24", "size": "24px" },
				{ "slug": "50", "name": "32", "size": "32px" },
				{ "slug": "60", "name": "48", "size": "48px" },
				{ "slug": "70", "name": "64", "size": "64px" },
				{ "slug": "80", "name": "96", "size": "96px" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fontStyle": false,
			"fontWeight": false,
			"letterSpacing": false,
			"textDecoration": false,
			"textTransform": false,
			"fontFamilies": [
				{ "slug": "display", "name": "EB Garamond", "fontFamily": "\"EB Garamond\", Georgia, serif" },
				{ "slug": "ui", "name": "Inter", "fontFamily": "\"Inter\", Arial, sans-serif" }
			],
			"fontSizes": [
				{ "slug": "caption", "name": "Caption", "size": "0.75rem" },
				{ "slug": "body-s", "name": "Body S", "size": "0.9375rem" },
				{ "slug": "body", "name": "Body", "size": "1.0625rem" },
				{ "slug": "body-l", "name": "Body L", "size": "1.25rem" },
				{ "slug": "h4", "name": "H4", "size": "clamp(1.4375rem, 2vw, 1.625rem)" },
				{ "slug": "h3", "name": "H3", "size": "clamp(1.75rem, 2.6vw, 2rem)" },
				{ "slug": "h2", "name": "H2", "size": "clamp(2.125rem, 3.6vw, 2.75rem)" },
				{ "slug": "h1", "name": "H1", "size": "clamp(2.625rem, 5vw, 3.5rem)" }
			]
		},
		"useRootPaddingAwareAlignments": false
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--cream)",
			"text": "var(--wp--preset--color--charcoal)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--ui)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.1"
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--charcoal)" }
			}
		}
	}
}

{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/cards/**",
              "components/content/**",
              "components/forms/**",
              "components/media/**",
              "components/navigation/**",
              "components/primitives/**",
              "components/sections/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:EB Garamond|Inter))/i]",
        "message": "Font not provided by the design system. Available: EB Garamond, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|answer|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: question, answer."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|category|readingTime|image|imageAlt|href|key|ref|className|style|children)$/]",
        "message": "<ArticleCard> doesn't accept that prop. Declared props: title, category, readingTime, image, imageAlt, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|sage|solid)$/]",
        "message": "<Badge> variant must be one of 'outline' | 'sage' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BeforeAfter'] > JSXAttribute > JSXIdentifier[name!=/^(?:beforeSrc|afterSrc|beforeAlt|afterAlt|context|protocol|elapsed|disclaimer|defaultPosition|key|ref|className|style|children)$/]",
        "message": "<BeforeAfter> doesn't accept that prop. Declared props: beforeSrc, afterSrc, beforeAlt, afterAlt, context, protocol, elapsed, disclaimer, defaultPosition."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|arrow|loading|disabled|children|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, arrow, loading, disabled, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|sage|text)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'sage' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|label|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: type, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:checkbox|radio)$/]",
        "message": "<Checkbox> type must be one of 'checkbox' | 'radio'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTASection'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|primaryCta|secondaryCta|onPrimary|onSecondary|tone|key|ref|className|style|children)$/]",
        "message": "<CTASection> doesn't accept that prop. Declared props: title, body, primaryCta, secondaryCta, onPrimary, onSecondary, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTASection'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<CTASection> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DarkSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|compact|className|key|ref|className|style|children)$/]",
        "message": "<DarkSection> doesn't accept that prop. Declared props: children, compact, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='DoctorCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|credentials|image|imageAlt|href|cta|key|ref|className|style|children)$/]",
        "message": "<DoctorCard> doesn't accept that prop. Declared props: name, role, credentials, image, imageAlt, href, cta."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditorialSplit'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|children|cta|onCta|ctaHref|image|imageAlt|imagePlaceholder|ratio|flip|compact|key|ref|className|style|children)$/]",
        "message": "<EditorialSplit> doesn't accept that prop. Declared props: eyebrow, title, children, cta, onCta, ctaHref, image, imageAlt, imagePlaceholder, ratio, flip, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditorialSplit'] > JSXAttribute[name.name='ratio'] > Literal[value!=/^(?:square|portrait|landscape|wide)$/]",
        "message": "<EditorialSplit> ratio must be one of 'square' | 'portrait' | 'landscape' | 'wide'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|htmlFor|optional|hint|error|children|className|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, htmlFor, optional, hint, error, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='GalleryItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|caption|key|ref|className|style|children)$/]",
        "message": "<GalleryItem> doesn't accept that prop. Declared props: src, alt, ratio, caption."
      },
      {
        "selector": "JSXOpeningElement[name.name='GalleryItem'] > JSXAttribute[name.name='ratio'] > Literal[value!=/^(?:square|portrait|landscape|wide)$/]",
        "message": "<GalleryItem> ratio must be one of 'square' | 'portrait' | 'landscape' | 'wide'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeaderLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<HeaderLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|subtitle|primaryCta|secondaryCta|onPrimary|onSecondary|image|imageAlt|imagePlaceholder|ratio|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: eyebrow, title, subtitle, primaryCta, secondaryCta, onPrimary, onSecondary, image, imageAlt, imagePlaceholder, ratio."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute[name.name='ratio'] > Literal[value!=/^(?:square|portrait|landscape|wide)$/]",
        "message": "<Hero> ratio must be one of 'square' | 'portrait' | 'landscape' | 'wide'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='Media'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|flush|placeholder|overlay|key|ref|className|style|children)$/]",
        "message": "<Media> doesn't accept that prop. Declared props: src, alt, ratio, flush, placeholder, overlay."
      },
      {
        "selector": "JSXOpeningElement[name.name='Media'] > JSXAttribute[name.name='ratio'] > Literal[value!=/^(?:square|portrait|landscape|wide)$/]",
        "message": "<Media> ratio must be one of 'square' | 'portrait' | 'landscape' | 'wide'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MobileNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|onNavigate|logoSrc|items|cta|onCtaClick|key|ref|className|style|children)$/]",
        "message": "<MobileNav> doesn't accept that prop. Declared props: open, onClose, onNavigate, logoSrc, items, cta, onCtaClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='NeedCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:need|note|href|boxed|key|ref|className|style|children)$/]",
        "message": "<NeedCard> doesn't accept that prop. Declared props: need, note, href, boxed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|cite|align|key|ref|className|style|children)$/]",
        "message": "<Quote> doesn't accept that prop. Declared props: children, cite, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Quote> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResultsSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|intro|cases|cta|onCta|key|ref|className|style|children)$/]",
        "message": "<ResultsSection> doesn't accept that prop. Declared props: eyebrow, title, intro, cases, cta, onCta."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|placeholder|invalid|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: options, placeholder, invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|author|context|key|ref|className|style|children)$/]",
        "message": "<TestimonialCard> doesn't accept that prop. Declared props: quote, author, context."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|quiet|children|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: href, quiet, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='TreatmentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|category|description|image|imageAlt|ratio|badges|href|cta|key|ref|className|style|children)$/]",
        "message": "<TreatmentCard> doesn't accept that prop. Declared props: name, category, description, image, imageAlt, ratio, badges, href, cta."
      },
      {
        "selector": "JSXOpeningElement[name.name='TreatmentCard'] > JSXAttribute[name.name='ratio'] > Literal[value!=/^(?:square|portrait|landscape|wide)$/]",
        "message": "<TreatmentCard> ratio must be one of 'square' | 'portrait' | 'landscape' | 'wide'."
      }
    ]
  },
